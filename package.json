    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fdir": "^6.5.0",
    "globals": "^15.15.0",
    "husky": "^8.0.3",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "nanoid": "^5.1.16",
    "object-hash": "^3.0.0",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "react": "18.2.0",
    "react-dom": "18.2.0"
